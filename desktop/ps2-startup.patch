+		right.r, right.g, right.b, 255, left.r, left.g, left.b, 255
+	};
+	glVertexPointer(2, GL_FLOAT, 0, vertices);
+	glColorPointer(4, GL_UNSIGNED_BYTE, 0, colors);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+}
