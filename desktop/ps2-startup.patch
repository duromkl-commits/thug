+extern "C" void desktop_start_story_ghosting(int milliseconds)
+{
+	const Uint64 now = SDL_GetPerformanceCounter();
+	const Uint64 until = now + SDL_GetPerformanceFrequency() * milliseconds / 1000;
+	if (now >= s_story_ghost_until)
+		s_story_ghost_start = now;
+	if (until > s_story_ghost_until)
+		s_story_ghost_until = until;
+}
+
+static float ghosting_strength()
+{
+	float strength = desktop_config().ghosting;
+	const float chaos = desktop_chaos_ghost();
+	if (chaos > strength)
+		strength = chaos;
+	const Uint64 now = SDL_GetPerformanceCounter();
+	if (now < s_story_ghost_until)
+	{
+		const float phase = float(now - s_story_ghost_start) /
+		                    float(s_story_ghost_until - s_story_ghost_start);
+		float fade = phase < 0.25f ? phase * 4.0f : (1.0f - phase) * 2.0f;
+		if (fade > 1.0f) fade = 1.0f;
+		const float pulse = 0.96f * fade * fade * (3.0f - 2.0f * fade);
+		if (pulse > strength) strength = pulse;
+	}
+	return strength;
+}
